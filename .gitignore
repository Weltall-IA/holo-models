/bench/**/results/
/bench/**/artifacts/
/bench/**/runs/
/bench/**/outputs/
/bench/**/logs/
/bench/**/RESULTADOS_*.md
/bench/**/*.csv
/bench/**/*.jsonl
/bench/**/*.tar
/bench/**/*.tar.*
/bench/**/*.zst
/bench/**/*.sha256
/benchmarks/**/data/
/benchmarks/**/results/
/benchmarks/**/artifacts/
/benchmarks/**/runs/
/benchmarks/**/outputs/
/benchmarks/**/logs/
/benchmarks/**/RESULTADOS_*.md
/benchmarks/**/*.csv
/benchmarks/**/*.jsonl
/benchmarks/**/*.tar
/benchmarks/**/*.tar.*
/benchmarks/**/*.zst
/benchmarks/**/*.sha256
/tasks/**/results/
/tasks/**/artifacts/
/tasks/**/outputs/
/tasks/**/worktrees/
/tasks/**/benchmarks/
/tasks/**/humaneval/*.csv
/tasks/**/humaneval/*.json
/tasks/**/humaneval/*.jsonl
/tasks/**/humaneval/*.txt
/tasks/**/ctx_*.txt
/tasks/**/vram_*.txt
/tasks/**/*.tar
/tasks/**/*.tar.*
/tasks/**/*.zst
/tasks/**/*.sha256

# Segredos e tokens
.env
.env.*
!.env.example
.hf_token
*.secret

# Estado local do Kilo
.kilo/kilo.json
.kilo/kilo.jsonc
.kilo/kilo.jsonc.*
.kilo/agents/
.kilo/node_modules/
.kilo/package.json
.kilo/package-lock.json
