      "user": "Onde a função normalize_ranges é definida? Quero arquivo e linha da definição, não ocorrências de texto.",
      "tools": ["find_symbol", "search_repo", "read_file"],
      "stubs": [
        {
          "tool": "find_symbol",
          "arguments": {"name": {"equals": "normalize_ranges"}},
          "result": {"symbol": "normalize_ranges", "kind": "function", "path": "src/ranges.py", "line": 87}
        }
      ],
      "expected": {
        "tool_sequence": ["find_symbol"],
        "argument_rules": [
          {"index": 0, "tool": "find_symbol", "name": {"equals": "normalize_ranges"}}
        ],
        "final_must_include": ["src/ranges.py", "87"],
        "final_must_not_include": ["NO_MATCHING_STUB"],
        "forbid_extra_tool_calls": true
      }
    },
