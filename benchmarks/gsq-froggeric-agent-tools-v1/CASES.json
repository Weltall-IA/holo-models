{
  "schema_version": "gsq-froggeric-agent-tools-v1",
  "seed": 9137,
  "system_prompt": "Você é um agente de software. Use ferramentas quando o pedido depender de dados externos ao texto da conversa. Não invente resultados de ferramentas. Quando já houver informação suficiente no pedido, responda diretamente sem chamar ferramenta.",
  "tool_catalog": {
    "read_file": {
      "type": "function",
      "function": {
        "name": "read_file",
        "description": "Lê um arquivo do workspace, opcionalmente por intervalo de linhas.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {"type": "string"},
            "start_line": {"type": "integer", "minimum": 1},
            "end_line": {"type": "integer", "minimum": 1}
          },
          "required": ["path"],
          "additionalProperties": false
        }
      }
    },
    "search_repo": {
      "type": "function",
      "function": {
        "name": "search_repo",
        "description": "Procura texto no workspace e retorna caminhos/linhas relevantes.",
        "parameters": {
          "type": "object",
          "properties": {
            "query": {"type": "string"},
            "glob": {"type": "string"}
          },
          "required": ["query"],
          "additionalProperties": false
        }
      }
    },
    "find_symbol": {
      "type": "function",
      "function": {
        "name": "find_symbol",
        "description": "Localiza a definição canônica de um símbolo de código.",
        "parameters": {
          "type": "object",
          "properties": {
            "name": {"type": "string"}
          },
          "required": ["name"],
          "additionalProperties": false
        }
      }
    },
    "list_dir": {
      "type": "function",
      "function": {
        "name": "list_dir",
        "description": "Lista entradas de um diretório do workspace.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {"type": "string"}
          },
          "required": ["path"],
          "additionalProperties": false
        }
      }
    },
    "calculator": {
      "type": "function",
      "function": {
        "name": "calculator",
        "description": "Calcula uma expressão aritmética.",
        "parameters": {
          "type": "object",
          "properties": {
            "expression": {"type": "string"}
          },
          "required": ["expression"],
          "additionalProperties": false
        }
      }
    }
  },
  "matching_semantics": {
    "equals": "o argumento deve ser exatamente igual",
    "contains_all_ci": "string deve conter todos os termos, ignorando maiúsculas/minúsculas",
    "forbid_extra_tool_calls": "nenhuma chamada além da sequência esperada é permitida",
    "default_unmatched_tool_result": {"error": "NO_MATCHING_STUB"}
  },
  "cases": [
    {
      "id": "T01",
      "title": "single_tool_exact_file",
      "user": "Leia pyproject.toml e me diga somente a versão declarada de holo_core. Não chute.",
      "tools": ["read_file", "search_repo"],
      "stubs": [
        {
          "tool": "read_file",
          "arguments": {"path": {"equals": "pyproject.toml"}},
          "result": "[project.dependencies]\nholo_core = \"2.7.4\"\nrequests = \"2.32.4\""
        }
      ],
      "expected": {
        "tool_sequence": ["read_file"],
        "argument_rules": [
          {"index": 0, "tool": "read_file", "path": {"equals": "pyproject.toml"}}
        ],
        "final_must_include": ["2.7.4"],
        "final_must_not_include": ["NO_MATCHING_STUB"],
        "forbid_extra_tool_calls": true
      }
    },
    {
      "id": "T02",
