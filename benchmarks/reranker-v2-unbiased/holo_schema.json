{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Holo Reranker V2 Gold Query",
  "type": "object",
  "required": ["query_id", "group_id", "intent_id", "query", "language", "category", "relevant_doc_ids"],
  "properties": {
    "query_id": {"type": "string", "minLength": 1},
    "group_id": {"type": "string", "minLength": 1},
    "intent_id": {"type": "string", "minLength": 1},
    "query": {"type": "string", "minLength": 1},
    "language": {"enum": ["pt-BR", "en"]},
    "category": {"enum": ["agents", "rules", "capabilities", "routing", "docs"]},
    "relevant_doc_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
